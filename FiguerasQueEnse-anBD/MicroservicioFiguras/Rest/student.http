### ========================================
### STUDENTS - REGLAS JWT
### - tutor solo su grupo
### - student solo sus propios datos
### ========================================

### [OK] Tutor 47: solo estudiantes de tutor 47
GET {{host}}/students
Authorization: Bearer {{tutor47Token}}
Accept: application/json

### [OK] Tutor 47: estudiante 17 (asignado)
GET {{host}}/students/{{student17}}
Authorization: Bearer {{tutor47Token}}
Accept: application/json

### [FORBIDDEN esperado] Tutor 47: estudiante 19 (es de tutor 48)
GET {{host}}/students/{{student19}}
Authorization: Bearer {{tutor47Token}}
Accept: application/json

### [OK] Student 19: ver su propio perfil
GET {{host}}/students/{{student19}}
Authorization: Bearer {{student19Token}}
Accept: application/json

### [FORBIDDEN esperado] Student 17: no puede ver student 18
GET {{host}}/students/{{student18}}
Authorization: Bearer {{student17Token}}
Accept: application/json

### [OK] Tutor 47: tutor de student 17
GET {{host}}/students/{{student17}}/tutor
Authorization: Bearer {{tutor47Token}}
Accept: application/json

### [OK] Tutor 47: ids de sus estudiantes
GET {{host}}/students/tutor/{{tutor47}}/ids
Authorization: Bearer {{tutor47Token}}
Accept: application/json

### [FORBIDDEN esperado] Tutor 48 no puede pedir ids de tutor 47
GET {{host}}/students/tutor/{{tutor47}}/ids
Authorization: Bearer {{tutor48Token}}
Accept: application/json

### [OK] Student 17: ids de sus sesiones
GET {{host}}/students/{{student17}}/sessions/ids
Authorization: Bearer {{student17Token}}
Accept: application/json

### [FORBIDDEN esperado] Student 17 no puede pedir sesiones de student 19
GET {{host}}/students/{{student19}}/sessions/ids
Authorization: Bearer {{student17Token}}
Accept: application/json

### ========================================
### CRUD TECNICO (usar con cuidado)
### Nota: para usuarios con login funcional, crear por Auth Service
### ========================================

### POST /students (microservicio directo)
POST {{host}}/students
Authorization: Bearer {{tutor47Token}}
Content-Type: application/json

{
  "idTutor": {{17 }},
  "name": "Ana Lopez",
  "email": "ana.student@example.com",
  "passwordHash": "StudentPass123",
  "age": 10,
  "gender": "F",
  "country": "CO",
  "neurodivergency": "None"
}

### PUT /students/{id}
PUT {{host}}/students/{{student17}}
Authorization: Bearer {{tutor47Token}}
Content-Type: application/json

{
  "idTutor": {{17 }},
  "name": "Ana Lopez Actualizada",
  "email": "ana.student@example.com",
  "passwordHash": "StudentPass1234",
  "age": 11,
  "gender": "M",
  "country": "CO",
  "neurodivergency": "None"
}

### DELETE /students/{id}
### CUIDADO: elimina tambien sus sesiones/resultados por FK segun BD
DELETE {{host}}/students/{{student18}}
Authorization: Bearer {{tutor47Token}}
Accept: application/json
