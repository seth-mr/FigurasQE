{
  "info": {
    "_postman_id": "f2a07ee5-173c-4867-b63b-57a6db4d52e4",
    "name": "FQE Auth via Gateway",
    "description": "Pruebas automatizadas del Auth Service accediendo a traves del gateway. Cubre validaciones, nulos, errores esperados y casos felices.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('seedSuffix')) {",
          "  const suffix = Date.now().toString() + Math.floor(Math.random() * 10000).toString();",
          "  pm.collectionVariables.set('seedSuffix', suffix);",
          "  pm.collectionVariables.set('newStudentEmail', `newman.student.${suffix}@mail.com`);",
          "  pm.collectionVariables.set('newTutorEmail', `newman.tutor.${suffix}@mail.com`);",
          "  pm.collectionVariables.set('newStudentPassword', 'StudentDemo123!');",
          "  pm.collectionVariables.set('newTutorPassword', 'TutorDemo123!');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login - body vacio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Regresa 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Regresa envelope de error del gateway', function () {",
              "  pm.expect(body.message).to.eql('Authentication Service Error');",
              "  pm.expect(body.errors).to.be.an('object');",
              "});",
              "pm.test('Valida email y password requeridos', function () {",
              "  pm.expect(body.errors).to.have.property('Email');",
              "  pm.expect(body.errors).to.have.property('Password');",
              "});"
            ]
          }
        }
      ]
    },
    {
