        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Regresa 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Mensaje esperado', function () {",
              "  pm.expect(body.message).to.eql('Invalid credentials');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - estudiante existente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{existingStudentEmail}}\",\n  \"password\": \"{{existingStudentPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Regresa 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Entrega token y role student', function () {",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.role).to.eql('student');",
              "  pm.expect(body.admin).to.eql(null);",
              "});",
              "pm.collectionVariables.set('studentToken', body.token);"
            ]
          }
        }
      ]
    },
