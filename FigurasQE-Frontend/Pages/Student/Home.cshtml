@page
@model HomeModel
@{
    ViewData["Title"] = "Panel del estudiante";
    Layout = "_LayoutNoHeader";
}

<section class="student-dashboard">
    <div class="student-home-hero">
        <div>
            <p class="eyebrow">Panel del estudiante</p>
            <h1>Bienvenido @(string.IsNullOrWhiteSpace(Model.Student.Name) ? "Estudiante" : Model.Student.Name)</h1>
            <p>Consulta tus datos, revisa a tu tutor asignado y sigue tu historial de juego desde una sola vista.</p>
        </div>
        <div class="hero-actions">
            <a asp-page="/Levels/LevelsCatalog" class="btn btn-light">Jugar</a>
            <a asp-page="/User/Logout" class="btn btn-outline-light">Cerrar sesión</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    <div class="student-home-grid">
        <article class="panel-card">
            <p class="eyebrow">Mi espacio</p>
            <h2>@(string.IsNullOrWhiteSpace(Model.Student.Name) ? "Estudiante" : Model.Student.Name)</h2>
            <p class="muted-copy">Accede a tus datos personales, tu tutor asignado y el detalle completo de tus sesiones.</p>
            <div class="student-count">
                <span>@Model.Sessions.Count</span>
                <p>@(Model.Sessions.Count == 1 ? "sesión registrada" : "sesiones registradas")</p>
            </div>
            <div class="stacked-actions">
                <a asp-page="/Student/Detail" class="btn btn-success w-100">Ver mis datos</a>
                <a asp-page="/Student/Profile" class="btn btn-outline-success w-100">Editar perfil</a>
            </div>
        </article>

        <article class="panel-card">
            <p class="eyebrow">Tutor asignado</p>
            @if (Model.Student.Tutor == null)
            {
                <h2>Aún no tienes tutor.</h2>
                <p class="muted-copy">Cuando un profesor te asigne por correo, su información aparecerá aquí.</p>
            }
            else
            {
                <dl class="summary-list">
                    <div>
                        <dt>Nombre</dt>
                        <dd>@Model.Student.Tutor.Name</dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd>@Model.Student.Tutor.Email</dd>
                    </div>
                    <div>
                        <dt>País</dt>
                        <dd>@Model.FormatCountry(Model.Student.Tutor.Country)</dd>
                    </div>
                </dl>
            }
        </article>

        <article class="panel-card session-summary-card">
            <p class="eyebrow">Resumen de sesiones</p>
            <dl class="summary-list">
                <div>
                    <dt>Tiempo total jugado</dt>
                    <dd>@Model.FormatTotalPlayedTime()</dd>
                </div>
                <div>
                    <dt>Niveles completados</dt>
                    <dd>@Model.CompletedLevelsCount()</dd>
                </div>
                <div>
                    <dt>Última sesión</dt>
                    <dd>@Model.LastSessionText()</dd>
                </div>
            </dl>
        </article>
    </div>
</section>
