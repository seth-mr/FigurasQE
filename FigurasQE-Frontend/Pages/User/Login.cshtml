@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutNoHeader";
}
<div class="text-center mb-4">
    <a asp-page="/Index" class="link-dark display-4 link-offset-2 link-underline link-underline-opacity-0" ">Figuras Que Enseñan</a>
</div>

<div class=" d-flex justify-content-center align-items-center p-4 bg-white rounded shadow">
    <form method="post">

        <h2 class="text-center mb-3">Iniciar Sesión</h2>
        
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert alert-danger text-center mb-3">
                <ul class="mb-0 list-unstyled">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
        
        <div class="form-floating mb-3">
            <input asp-for="Email" type="email"
                   class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")"
                   placeholder="" />
            <label asp-for="Email">Correo</label>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Password" type="password"
                   class="form-control @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                   placeholder="" />
            <label asp-for="Password">Contraseña</label>
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-3">
            Entrar
        </button>

        <div class="text-center">
            <a asp-page="/User/Signup" class="text-decoration-none">
                ¿No tienes una cuenta? Crea una cuenta
            </a>
        </div>

    </form>
</div>
