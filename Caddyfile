(figurasqe_routes) {
    handle_path /api/* {
        reverse_proxy gateway:3000
    }

    handle {
        reverse_proxy frontend:8080
    }
}

https://{$LAN_IP}:8443, https://localhost:8443 {
    tls internal {
        curves x25519 secp256r1
    }

    import figurasqe_routes
}

http://:8088 {
    import figurasqe_routes
}
