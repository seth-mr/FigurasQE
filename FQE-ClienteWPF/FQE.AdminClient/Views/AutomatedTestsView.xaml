<UserControl x:Class="FQE.AdminClient.Views.AutomatedTestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <Grid Margin="28">
        <Border Padding="28"
                Background="{StaticResource PanelBrushAlt}"
                CornerRadius="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Pruebas automatizadas"
                                   FontSize="28"
                                   FontWeight="Bold" />
         
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="120"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="Volver"
                            Background="#2A4058"
                            Foreground="{StaticResource TextBrush}"
                            Click="BackButton_Click" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,22,0,0"
                        Padding="22"
                        Background="#16000000"
                        CornerRadius="22">
                    <TextBlock Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="cada elemento representa un microservicio, cuidado con la viborita" />
                </Border>

                <ItemsControl Grid.Row="2"
                              x:Name="ServicesItemsControl"
                              Margin="0,24,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,16"
                                    Padding="18"
                                    Background="{StaticResource PanelBrush}"
                                    CornerRadius="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding Description}" />
                                        <Border Margin="0,14,0,0"
                                                Padding="12,10"
                                                Background="#0F1D2C"
                                                CornerRadius="14">
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                                           Text="Ruta de referencia" />
                                                <TextBlock Margin="0,6,0,0"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Route}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="18,0,0,0"
                                            Padding="12,8"
                                            Background="#153B2A"
                                            CornerRadius="999"
                                            VerticalAlignment="Top">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Pendiente" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


            </Grid>
        </Border>
    </Grid>
</UserControl>