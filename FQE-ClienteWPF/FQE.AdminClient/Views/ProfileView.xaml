<UserControl x:Class="FQE.AdminClient.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <Grid Margin="28">
        <Border Padding="28"
                Background="{StaticResource PanelBrushAlt}"
                CornerRadius="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Mi cuenta"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Consulta y modifica tu perfil" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="110"
                            Height="40"
                            Content="Recargar"
                            Click="RefreshButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombre" />
                        <TextBox x:Name="NameTextBox" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Usuario" />
                        <TextBox x:Name="UsernameTextBox" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Correo" />
                        <TextBox x:Name="EmailTextBox" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Telefono" />
                        <TextBox x:Name="PhoneTextBox" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <TextBlock Text="Nueva contrasenia opcional" />
                    <PasswordBox x:Name="NewPasswordBox" />
                </StackPanel>

                <Border Grid.Row="4"
                        Margin="0,22,0,0"
                        Padding="18"
                        Background="#16000000"
                        CornerRadius="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Alta" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RegistrationDateText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="-" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="5"
                           x:Name="StatusText"
                           Margin="0,20,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />

                <StackPanel Grid.Row="6"
                            Margin="0,20,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="150"
                            Content="Volver"
                            Background="#2A4058"
                            Foreground="{StaticResource TextBrush}"
                            Click="BackButton_Click" />
                    <Button Width="150"
                            Margin="12,8,0,0"
                            Content="Restaurar"
                            Background="#2A4058"
                            Foreground="{StaticResource TextBrush}"
                            Click="ResetButton_Click" />
                    <Button Width="180"
                            Margin="12,8,0,0"
                            Content="Guardar cambios"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>