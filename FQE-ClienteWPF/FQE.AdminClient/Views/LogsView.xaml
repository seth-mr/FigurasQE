<UserControl x:Class="FQE.AdminClient.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <UserControl.Resources>
        <Storyboard x:Key="ConnectionPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="ConnectionIndicatorScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1"
                             To="1.35"
                             Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="ConnectionIndicatorScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1"
                             To="1.35"
                             Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="ConnectionIndicator"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55"
                             To="1"
                             Duration="0:0:0.7" />
        </Storyboard>
        <Style x:Key="LogsFilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="#10243B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LogsFilterComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#10243B" />
            <Setter Property="Background" Value="#EAF2FB" />
        </Style>
        <DataTemplate x:Key="LogsFilterComboBoxItemTemplate">
            <TextBlock Text="{Binding}"
                       Foreground="#10243B"
                       FontWeight="SemiBold" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="28">
        <Border Padding="28"
                Background="{StaticResource PanelBrushAlt}"
                CornerRadius="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Logs del sistema"
                                       FontSize="28"
                                       FontWeight="Bold" />
                            <Border Margin="12,0,0,0"
                                    Padding="10,6"
                                    Background="#11243A"
                                    CornerRadius="999">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse x:Name="ConnectionIndicator"
                                             Width="12"
                                             Height="12"
                                             Fill="#DC2626"
                                             Opacity="0.95"
                                             VerticalAlignment="Center"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="ConnectionIndicatorScale"
                                                            ScaleX="1"
                                                            ScaleY="1" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="ConnectionIndicatorText"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Sin conexion" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Consulta eventos y filtrados por servicio" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <!-- Botón 'Exportar logs' eliminado -->
                        <Button Width="130"
                                Height="40"
                            Margin="12,0,0,0"
                                Content="Actualizar"
                                Click="RefreshButton_Click" />
                        <Button Width="120"
                                Height="40"
                                Margin="12,0,0,0"
                                Content="Volver"
                                Background="#2A4058"
                                Foreground="{StaticResource TextBrush}"
                                Click="BackButton_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,24,0,0"
                        Padding="20"
                        Background="#16000000"
                        CornerRadius="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Margin="0,0,0,12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Filtros" />

                            <WrapPanel>
                                <StackPanel Width="260" Margin="0,0,18,18">
                                    <TextBlock Text="Servicio" />
                                    <ComboBox x:Name="ServiceFilterComboBox"
                                              Style="{StaticResource LogsFilterComboBoxStyle}"
                                              ItemTemplate="{StaticResource LogsFilterComboBoxItemTemplate}"
                                              ItemContainerStyle="{StaticResource LogsFilterComboBoxItemStyle}" />
                                </StackPanel>

                                <StackPanel Width="180" Margin="0,0,18,18">
                                    <TextBlock Text="Tipo" />
                                    <ComboBox x:Name="TypeFilterComboBox"
                                              Style="{StaticResource LogsFilterComboBoxStyle}"
                                              ItemTemplate="{StaticResource LogsFilterComboBoxItemTemplate}"
                                              ItemContainerStyle="{StaticResource LogsFilterComboBoxItemStyle}" />
                                </StackPanel>

                                <StackPanel Width="180" Margin="0,0,18,18">
                                    <TextBlock Text="Entidad" />
                                    <ComboBox x:Name="EntityTypeFilterComboBox"
                                              Style="{StaticResource LogsFilterComboBoxStyle}"
                                              ItemTemplate="{StaticResource LogsFilterComboBoxItemTemplate}"
                                              ItemContainerStyle="{StaticResource LogsFilterComboBoxItemStyle}" />
                                </StackPanel>

                                <StackPanel Width="120" Margin="0,0,18,18">
                                    <TextBlock Text="Accion" />
                                    <ComboBox x:Name="ActionFilterComboBox"
                                              Style="{StaticResource LogsFilterComboBoxStyle}"
                                              ItemTemplate="{StaticResource LogsFilterComboBoxItemTemplate}"
                                              ItemContainerStyle="{StaticResource LogsFilterComboBoxItemStyle}" />
                                </StackPanel>

                                <StackPanel Width="120" Margin="0,0,18,18">
                                    <TextBlock Text="Estado" />
                                    <ComboBox x:Name="StatusClassFilterComboBox"
                                              Style="{StaticResource LogsFilterComboBoxStyle}"
                                              ItemTemplate="{StaticResource LogsFilterComboBoxItemTemplate}"
                                              ItemContainerStyle="{StaticResource LogsFilterComboBoxItemStyle}" />
                                </StackPanel>

                                <StackPanel Width="260" Margin="0,0,18,18">
                                    <TextBlock Text="Ruta contiene" />
                                    <TextBox x:Name="RouteFilterTextBox"
                                             Height="34"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="18,12"
                                    Background="#11243A"
                                    CornerRadius="18"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total cargado: " Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="TotalLogsText"
                                               FontWeight="SemiBold"
                                               Text="0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Width="140"
                                        Height="40"
                                        Margin="0"
                                        Content="Aplicar filtro"
                                        Click="ApplyFiltersButton_Click" />
                                <Button Width="110"
                                        Height="40"
                                        Margin="12,0,0,0"
                                        Content="Limpiar"
                                        Background="#2A4058"
                                        Foreground="{StaticResource TextBrush}"
                                        Click="ClearFiltersButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           x:Name="StatusText"
                           Margin="0,18,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="Cargando logs..." />

                <DataGrid Grid.Row="3"
                          x:Name="LogsDataGrid"
                          Margin="0,18,0,0"
                          AutoGenerateColumns="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                            Width="180" />
                        <DataGridTextColumn Header="Servicio"
                                            Binding="{Binding Service}"
                                            Width="140" />
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Type}"
                                            Width="110" />
                        <DataGridTextColumn Header="Accion"
                                            Binding="{Binding Action}"
                                            Width="85" />
                        <DataGridTextColumn Header="Ruta"
                                            Binding="{Binding Route}"
                                            Width="230" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding StatusCode}"
                                            Width="80" />
                        <DataGridTextColumn Header="ms"
                                            Binding="{Binding DurationMs}"
                                            Width="70" />
                        <DataGridTextColumn Header="Entidad"
                                            Binding="{Binding EntityType}"
                                            Width="90" />
                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding EntityId}"
                                            Width="70" />
                    </DataGrid.Columns>
                </DataGrid>

        
            </Grid>
        </Border>
    </Grid>
</UserControl>